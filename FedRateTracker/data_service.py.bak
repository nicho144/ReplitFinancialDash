    def process_notifications(self):
        """Process news items for notifications based on high-impact keywords"""
        try:
            # Get recent news
            news_data = self.get_financial_news()
            
            # High-impact keywords to scan for
            high_impact_keywords = {
                # FDA related
                "FDA approval": 2,
                "fast track": 2,
                "breakthrough": 2,
                "orphan drug": 2,
                "priority review": 2,
                
                # Analyst ratings
                "upgrade": 1,
                "downgrade": 1,
                "initiates coverage": 1,
                "price target": 1,
                "strong buy": 2,
                "strong sell": 2,
                
                # Corporate actions
                "acquisition": 2,
                "merger": 2,
                "takeover": 2,
                "buyout": 2,
                "spinoff": 2,
                "strategic alternatives": 1,
                
                # Earnings
                "earnings beat": 1,
                "earnings miss": 1,
                "revenue beat": 1,
                "revenue miss": 1,
                "guidance raised": 2,
                "guidance lowered": 2,
                "earnings surprise": 2,
                
                # Other high impact
                "clinical trial results": 2,
                "patent": 1,
                "investigation": 2,
                "lawsuit": 1,
                "recall": 2,
                "CEO": 1
            }
            
            # Process each news item
            for article in news_data:
                title = article.get("title", "")
                source = article.get("source", {}).get("name", "Unknown")
                url = article.get("url", "")
                timestamp = article.get("publishedAt", datetime.now())
                
                # Convert to datetime if needed
                if isinstance(timestamp, str):
                    try:
                        timestamp = datetime.strptime(timestamp, "%Y-%m-%dT%H:%M:%SZ")
                    except:
                        timestamp = datetime.now()
                
                # Scan for high-impact keywords
                found_keywords = []
                max_priority = 0
                
                for keyword, priority in high_impact_keywords.items():
                    if keyword.lower() in title.lower():
                        found_keywords.append(keyword)
                        max_priority = max(max_priority, priority)
                
                # Only create notification if high-impact keywords are found
                if found_keywords:
                    # Extract stock symbol if present (simple regex approach)
                    import re
                    symbol_match = re.search(r'\(([A-Z]{1,5})\)', title)
                    stock_symbol = symbol_match.group(1) if symbol_match else None
                    
                    # Determine market cap category (would use real data in production)
                    market_cap_category = "Mid Cap"  # Default
                    
                    # Simple sentiment analysis based on keywords
                    # Positive keywords
                    positive_keywords = [
                        "surge", "rally", "jump", "gain", "rise", "soar", "beat", "positive",
                        "bullish", "upgrade", "growth", "upside", "optimism", "recovery"
                    ]
                    
                    # Negative keywords
                    negative_keywords = [
                        "plunge", "drop", "fall", "decline", "slip", "tumble", "miss", "negative",
                        "bearish", "downgrade", "loss", "downside", "recession", "risk", "warning"
                    ]
                    
                    # Count keyword occurrences
                    positive_count = sum(1 for word in positive_keywords if word.lower() in title.lower())
                    negative_count = sum(1 for word in negative_keywords if word.lower() in title.lower())
                    
                    # Determine sentiment
                    if positive_count > negative_count:
                        sentiment = "positive"
                    elif negative_count > positive_count:
                        sentiment = "negative"
                    else:
                        sentiment = "neutral"
                    
                    # Store the notification
                    self.db.store_notification(
                        timestamp,
                        title,
                        source,
                        url,
                        found_keywords,
                        sentiment,
                        market_cap_category,
                        stock_symbol,
                        max_priority
                    )
                    
                    print(f"Storing notification: '{title}' from {source}")
                    
                    # Also send push notification if high priority
                    if max_priority >= 2:
                        # Send push notification (would use actual push notification service in production)
                        notification_data = {
                            "title": f"High Impact Alert: {title}",
                            "body": f"Source: {source}",
                            "url": url,
                            "priority": max_priority
                        }
                        
                        # This would call an actual notification service in production
                        #self.notification_manager.send_notification_from_alert(notification_data)
            
            return True
            
        except Exception as e:
            print(f"Error in process_notifications: {e}")
            return False
    
