            return False
    
    def generate_market_alerts(self):
        """Generate market alerts based on current market conditions
        This will create alerts for bullish/bearish signals in gold, SPY, and other indicators
        """
        try:
            # Get current market data
            market_signals = self.get_market_open_signals()
            treasury_data = self.get_treasury_yields()
            volatility_data = self.get_market_breadth()
            futures_data = self.get_futures_fair_value()
            
            alerts = []
            
            # Check for significant moves in gold
            if market_signals and "gold" in market_signals:
                gold_data = market_signals["gold"]
                if "change_pct" in gold_data:
                    change_pct = gold_data["change_pct"]
                    if change_pct > 1.5:
                        alerts.append({
                            "timestamp": datetime.now(),
                            "title": f"Gold surges {change_pct:.2f}% - defensive positioning recommended",
                            "source": "Market Alert",
                            "url": "#",
                            "keywords": ["gold", "surge", "defensive"],
                            "sentiment": "neutral",
                            "market_cap_category": "N/A",
                            "stock_symbol": "GLD",
                            "priority": 2
                        })
                    elif change_pct < -1.5:
                        alerts.append({
                            "timestamp": datetime.now(),
                            "title": f"Gold plunges {abs(change_pct):.2f}% - risk-on sentiment prevails",
                            "source": "Market Alert",
                            "url": "#",
                            "keywords": ["gold", "plunge", "risk-on"],
                            "sentiment": "neutral",
                            "market_cap_category": "N/A",
                            "stock_symbol": "GLD",
                            "priority": 2
                        })
            
            # Check for significant moves in Treasury yields
            if treasury_data and "current" in treasury_data:
                current_yields = treasury_data["current"]
                
                if "spread_2y_10y" in current_yields:
                    spread = current_yields["spread_2y_10y"]
                    if spread is not None and spread < -0.5:
                        alerts.append({
                            "timestamp": datetime.now(),
                            "title": f"Deep yield curve inversion at {spread:.2f}% signals recession risk",
                            "source": "Bond Alert",
                            "url": "#",
                            "keywords": ["yield curve", "inversion", "recession"],
                            "sentiment": "negative",
                            "market_cap_category": "N/A",
                            "stock_symbol": None,
                            "priority": 2
                        })
            
            # Check for high volatility
            if volatility_data and "vix" in volatility_data:
                vix = volatility_data["vix"]
                if vix > 30:
                    alerts.append({
                        "timestamp": datetime.now(),
                        "title": f"VIX spikes to {vix:.2f} - extreme market fear detected",
                        "source": "Volatility Alert",
                        "url": "#",
                        "keywords": ["VIX", "volatility", "fear"],
                        "sentiment": "negative",
                        "market_cap_category": "N/A",
                        "stock_symbol": "VIX",
                        "priority": 2
                    })
                elif vix < 12:
                    alerts.append({
                        "timestamp": datetime.now(),
                        "title": f"VIX at extremely low level of {vix:.2f} - complacency warning",
                        "source": "Volatility Alert",
                        "url": "#",
                        "keywords": ["VIX", "volatility", "complacency"],
                        "sentiment": "neutral",
                        "market_cap_category": "N/A",
                        "stock_symbol": "VIX",
                        "priority": 1
                    })
            
            # Check ES futures
            if futures_data and "es_change_pct" in futures_data:
                change_pct = futures_data["es_change_pct"]
                if change_pct > 1.0:
                    alerts.append({
                        "timestamp": datetime.now(),
                        "title": f"S&P futures jump {change_pct:.2f}% - strong bullish momentum",
                        "source": "Futures Alert",
                        "url": "#",
                        "keywords": ["S&P futures", "bullish", "momentum"],
                        "sentiment": "positive",
                        "market_cap_category": "N/A",
                        "stock_symbol": "ES",
                        "priority": 1
                    })
                elif change_pct < -1.0:
                    alerts.append({
                        "timestamp": datetime.now(),
                        "title": f"S&P futures fall {abs(change_pct):.2f}% - bearish pressure mounting",
                        "source": "Futures Alert",
                        "url": "#",
                        "keywords": ["S&P futures", "bearish", "pressure"],
                        "sentiment": "negative",
                        "market_cap_category": "N/A",
                        "stock_symbol": "ES",
                        "priority": 1
                    })
            
            # Store alerts as notifications
            for alert in alerts:
                self.db.store_notification(
                    alert["timestamp"],
                    alert["title"],
                    alert["source"],
                    alert["url"],
                    alert["keywords"],
                    alert["sentiment"],
                    alert["market_cap_category"],
                    alert["stock_symbol"],
                    alert["priority"]
                )
                
                print(f"Storing market alert: '{alert['title']}'")
            
            return alerts
            
        except Exception as e:
            print(f"Error in generate_market_alerts: {e}")
            return []
    
    def refresh_all_data(self):
        """Force refresh all data"""
        try:
            # Clear all cache to force refresh
            self.cache = {}
            self.cache_expiry = {}
            
            # Refresh all data types
            fed_funds = self.get_fed_funds_futures()
            treasury_yields = self.get_treasury_yields()
            market_open = self.get_market_open_signals()
            market_breadth = self.get_market_breadth()
            futures_fair_value = self.get_futures_fair_value()
            financial_news = self.get_financial_news()
            fda_calendar = self.get_fda_calendar()
            
            # Process notifications for latest news
            self.process_notifications()
            
            # Generate market alerts
            self.generate_market_alerts()
            
            return True
            
        except Exception as e:
            print(f"Error in refresh_all_data: {e}")
            return False